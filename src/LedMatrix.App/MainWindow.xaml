<Window x:Class="LedMatrix.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LedMatrix.App.Controls"
        Title="Deo's LED Matrix Manager"
        Icon="/Assets/app.ico"
        Width="1040" Height="900" MinWidth="820" MinHeight="680"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="340" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ===== Hardware banner (looks like a Windows InfoBar); hidden on a Framework Laptop 16 ===== -->
    <Border x:Name="HardwareBanner" Grid.Row="0" Grid.ColumnSpan="2" Margin="24,16,24,0" Padding="16,0,4,0"
            MinHeight="48" CornerRadius="4" BorderThickness="1" Visibility="Collapsed"
            Background="{DynamicResource InfoBarInformationalSeverityBackgroundBrush}"
            BorderBrush="{DynamicResource InfoBarBorderBrush}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                   VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.Name="Information"
                   Foreground="{DynamicResource InfoBarInformationalSeverityIconBackground}" />
        <Button DockPanel.Dock="Right" Click="HardwareBannerClose_Click" Width="32" Height="32" Padding="0"
                Margin="8,7,4,7" VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                ToolTip="Close" AutomationProperties.Name="Close message">
          <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
        </Button>
        <TextBlock x:Name="HardwareBannerText" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,12,0,12" />
      </DockPanel>
    </Border>

    <!-- ===== Sidebar (mirrors the controls panel of ledmatrix.frame.work) ===== -->
    <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="24,20,16,24">
        <TextBlock Text="LED Matrix Manager" FontSize="22" FontWeight="SemiBold" />
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
          <Ellipse x:Name="StateDot" Width="10" Height="10" VerticalAlignment="Center" Fill="Gray" />
          <TextBlock x:Name="StateText" Margin="8,0,0,0" VerticalAlignment="Center"
                     AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <!-- Devices -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="Devices" />
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <DockPanel>
              <Button x:Name="LeftIdentifyButton" DockPanel.Dock="Right" Content="Identify" Tag="Left"
                      Click="Identify_Click" ToolTip="Blink this module so you can see which one it is" />
              <TextBox x:Name="LeftNameBox" Margin="0,0,8,0" Tag="Left" VerticalContentAlignment="Center"
                       LostKeyboardFocus="NameBox_LostFocus" KeyDown="NameBox_KeyDown"
                       AutomationProperties.Name="Left module name" ToolTip="Name for the left module" />
            </DockPanel>
            <TextBlock x:Name="LeftStatusText" Style="{StaticResource Caption}" Margin="0,6,0,0" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <DockPanel>
              <Button x:Name="RightIdentifyButton" DockPanel.Dock="Right" Content="Identify" Tag="Right"
                      Click="Identify_Click" ToolTip="Blink this module so you can see which one it is" />
              <TextBox x:Name="RightNameBox" Margin="0,0,8,0" Tag="Right" VerticalContentAlignment="Center"
                       LostKeyboardFocus="NameBox_LostFocus" KeyDown="NameBox_KeyDown"
                       AutomationProperties.Name="Right module name" ToolTip="Name for the right module" />
            </DockPanel>
            <TextBlock x:Name="RightStatusText" Style="{StaticResource Caption}" Margin="0,6,0,0" />
          </StackPanel>
        </Border>
        <WrapPanel>
          <Button x:Name="SwapButton" Content="Swap left / right" Click="Swap_Click" Margin="0,0,8,0"
                  ToolTip="Use if the drawings show up on the wrong module" />
          <Button Content="Rescan" Click="Rescan_Click" ToolTip="Look for modules again" />
        </WrapPanel>

        <!-- LEDs -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="LEDs" />
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="ModeAuto" Content="Automatic" GroupName="LedMode" Checked="Mode_Checked" Margin="0,0,16,0"
                       ToolTip="On while the laptop screen is in use, off otherwise" />
          <RadioButton x:Name="ModeOn" Content="On" GroupName="LedMode" Checked="Mode_Checked" Margin="0,0,16,0" />
          <RadioButton x:Name="ModeOff" Content="Off" GroupName="LedMode" Checked="Mode_Checked" />
        </StackPanel>
        <TextBlock Text="Brightness" Margin="0,14,0,4" />
        <DockPanel>
          <TextBlock x:Name="BrightnessValue" DockPanel.Dock="Right" Width="44" TextAlignment="Right" VerticalAlignment="Center" />
          <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="255" SmallChange="1" LargeChange="16"
                  IsMoveToPointEnabled="True" ValueChanged="Brightness_Changed"
                  AutomationProperties.Name="LED brightness" />
        </DockPanel>

        <!-- Drawing -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="Drawing" />
        <TextBlock Text="Brush brightness" Margin="0,0,0,4" />
        <DockPanel>
          <TextBlock x:Name="BrushValue" DockPanel.Dock="Right" Width="44" TextAlignment="Right" VerticalAlignment="Center" />
          <Slider x:Name="BrushSlider" Minimum="1" Maximum="255" SmallChange="1" LargeChange="16"
                  IsMoveToPointEnabled="True" ValueChanged="Brush_Changed"
                  AutomationProperties.Name="Brush brightness" />
        </DockPanel>
        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                   Text="Left-click to draw. Right-click (or Ctrl+click) to erase. Click and drag to paint. With the keyboard: arrows to move, Space to toggle." />

        <!-- Effects -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="Effects" />
        <CheckBox x:Name="CrtTransitionsCheck" Content="CRT power off/on when the content changes" Click="CrtTransitions_Click" />
        <TextBlock Style="{StaticResource Caption}" Margin="28,2,0,0"
                   Text="Turning the LEDs off (lid closed, screen off) always uses the normal fade." />

        <!-- Automatic on/off -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="Automatic on/off" />
        <CheckBox x:Name="AutoOffCheck" Content="Turn LEDs off when the laptop screen is off" Click="AutoOff_Click" />
        <StackPanel x:Name="AutoOffDetails" Margin="28,6,0,0">
          <CheckBox x:Name="LidCheck" Content="Lid is closed" Click="AutoOff_Click" Margin="0,2" />
          <CheckBox x:Name="PanelCheck" Content="Laptop screen not used (docked, second screen only)" Click="AutoOff_Click" Margin="0,2" />
          <CheckBox x:Name="DisplayOffCheck" Content="Windows turned the screen off" Click="AutoOff_Click" Margin="0,2" />
          <CheckBox x:Name="LockCheck" Content="PC is locked" Click="AutoOff_Click" Margin="0,2" />
        </StackPanel>
        <TextBlock x:Name="ScreenStateText" Style="{StaticResource Caption}" Margin="0,8,0,0" />
        <CheckBox x:Name="StartupCheck" Content="Start with Windows" Margin="0,16,0,0" Click="Startup_Click" />
        <TextBlock x:Name="StartupManagedText" Margin="0,16,0,0" TextWrapping="Wrap" Visibility="Collapsed">
          <Run Text="Starting with Windows is set in " />
          <Hyperlink Click="StartupSettings_Click">Settings › Apps › Startup</Hyperlink>
        </TextBlock>
        <CheckBox x:Name="DiagnosticsCheck" Content="Log dump for analysis" Margin="0,8,0,0" Click="Diagnostics_Click"
                  ToolTip="Adds one line a minute about CPU, memory and LED traffic to a file for each day" />
        <TextBlock x:Name="DiagnosticsText" Style="{StaticResource Caption}" Margin="26,2,0,0" Visibility="Collapsed">
          <Run Text="Writing to " />
          <Hyperlink Click="OpenLogs_Click"><Run x:Name="DiagnosticsFileRun" /></Hyperlink>
        </TextBlock>

        <!-- Footer -->
        <TextBlock Style="{StaticResource Caption}" Margin="0,24,0,0">
          <Run x:Name="VersionRun" />
          <Run Text=" · " />
          <Hyperlink NavigateUri="https://deovandski.github.io/Deo-s-Framework16-LED-Matrix-Manager/" RequestNavigate="Link_RequestNavigate">Website</Hyperlink>
          <Run Text=" · " />
          <Hyperlink Click="OpenLogs_Click">Logs</Hyperlink>
        </TextBlock>
      </StackPanel>
    </ScrollViewer>

    <!-- ===== Two LED matrices side by side (Left / Right) ===== -->
    <Grid Grid.Row="1" Grid.Column="1" Margin="8,20,24,24">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="16" />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <WrapPanel Grid.Row="0" Grid.ColumnSpan="3" HorizontalAlignment="Center" Margin="0,0,0,12">
        <TextBlock Text="Both modules:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
        <RadioButton x:Name="LinkIndependent" Content="Independent" GroupName="Link" Checked="Link_Checked" Margin="0,0,14,0"
                     ToolTip="Each module shows its own content" />
        <RadioButton x:Name="LinkMirror" Content="Mirror" GroupName="Link" Checked="Link_Checked" Margin="0,0,14,0"
                     ToolTip="The left module's content on both" />
        <RadioButton x:Name="LinkSpan" Content="Span" GroupName="Link" Checked="Link_Checked" Margin="0,0,14,0"
                     ToolTip="The left module's content stretched across both, edge to edge" />
        <CheckBox x:Name="GapCheck" Content="Keyboard gap" Click="Gap_Click" VerticalAlignment="Center"
                  ToolTip="In Span mode, things pass behind the keyboard for a moment instead of jumping across" />
      </WrapPanel>

      <TextBlock x:Name="LeftHeader" Grid.Row="1" Grid.Column="0" Text="Left" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
      <TextBlock x:Name="RightHeader" Grid.Row="1" Grid.Column="2" Text="Right" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />

      <controls:SideContentPanel x:Name="LeftPanel" Grid.Row="2" Grid.Column="0" Side="Left" Margin="0,8,0,4" />
      <controls:SideContentPanel x:Name="RightPanel" Grid.Row="2" Grid.Column="2" Side="Right" Margin="0,8,0,4" />

      <controls:LedGrid x:Name="LeftGrid" Grid.Row="3" Grid.Column="0" Margin="0,8,0,0"
                        AutomationProperties.Name="Left LED matrix, 9 by 34" />
      <controls:LedGrid x:Name="RightGrid" Grid.Row="3" Grid.Column="2" Margin="0,8,0,0"
                        AutomationProperties.Name="Right LED matrix, 9 by 34" />
    </Grid>
  </Grid>
</Window>
